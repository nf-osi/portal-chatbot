# build output
site/dist/
# generated types
site/.astro/

# dependencies
site/node_modules/

# content copied in from main's docs/ at build time (see site/README.md) —
# never commit real content to this branch, only the .gitkeep placeholders
site/src/content/docs/*
!site/src/content/docs/.gitkeep
site/public/diagrams/*
!site/public/diagrams/.gitkeep

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
